# Enable rewriting
RewriteEngine On

# 1) Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2) Force non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 3) Redirect /index.html and legacy pages to /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteRule ^old_index\.html$ / [R=301,L]
RewriteRule ^zerikai_web\.html$ / [R=301,L]
RewriteRule ^zerikai_index\.html$ / [R=301,L]

# Redirect missing legacy assets to home to clear 404 errors
Redirect 301 /src/assets/more_human_than_human_1200.avif /